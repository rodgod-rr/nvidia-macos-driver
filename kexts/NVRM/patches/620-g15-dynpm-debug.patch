+// G15 fork (macOS): who holds the dynamic power refcount. Counts of ref/unref per mode and the return addresses of the
+// last refs, read by NVRM through rm_xnu_dynamic_power_snapshot() and published as nvrm-dynpm-state.
+static volatile NvU32 g15RefCount[3], g15UnrefCount[3];
+static volatile NvU64 g15RefCaller[8];
+static volatile NvU32 g15RefCallerNext;
+// G15: GCx prerequisite checks: [0] runs, [1] control failed, [2] GC6 ok, [3] GCOFF ok, [4] neither; last used FB (MB),
+// last upstream-port-configured, last GCOFF memory gate result
+static volatile NvU32 g15Gcx[5], g15GcxUsedFbMb, g15GcxUpstream, g15GcxFbGate;
+static void g15NoteRef(nv_dynamic_power_mode_t mode, NvBool bRef, void *caller)
+{
+    if ((NvU32)mode < 3)
+    {
+        if (bRef) g15RefCount[mode]++; else g15UnrefCount[mode]++;
+    }
+    if (bRef)
+        g15RefCaller[(g15RefCallerNext++) & 7] = (NvU64)(NvUPtr)caller | ((NvU64)mode << 62);
+}
 
